---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import ScrollReveal from '../components/ScrollReveal.jsx';

const experiences = [
  {
    period: '2025 — Present',
    title: 'Java Full Stack Development Training',
    company: 'Qspiders — Chennai, Vadapalani',
    description: 'Engaged in an intensive training program specialized in Java Full Stack Development. Mastered end-to-end web engineering and built 4 major production-ready applications integrating React, Spring Boot, PostgreSQL, and WebSockets.',
    tags: ['Java', 'Spring Boot', 'React', 'PostgreSQL', 'REST APIs', 'WebSockets'],
    highlights: [
      'Engineered Cosmic IQ — enterprise workforce capability mapping SaaS platform',
      'Developed InterviewAce AI mock coaching chat utilizing WebSocket connections and OpenAI API',
      'Shipped DexterStore digital marketplace live on Netlify & Render services',
    ],
  },
  {
    period: '2022 — 2025',
    title: 'B.Sc. in Information Technology',
    company: 'SRNY College of Arts and Science — Kodikuruchi, Tenkasi',
    description: 'Completed Bachelor of Science in Information Technology, building robust foundations in data structures, database design, software development lifecycles, and core networks.',
    tags: ['Information Technology', 'C', 'Java', 'SQL', 'HTML/CSS', 'OOP'],
    highlights: [
      'Graduated with strong technical proficiency in IT concepts and database management systems',
      'Built Movie Explorer search application with OMDb REST API integrations',
      'Mastered Git version control and collaborative repositories on GitHub',
    ],
  },
];

---

<Layout title="Experience — Nithish">
  <Navbar client:load />

  <section class="pt-[72px]">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-28">
      
      <!-- Header -->
      <ScrollReveal client:load>
        <div class="mb-16 md:mb-24">
          <div class="flex items-center gap-3 mb-6" style="font-family: Inter, sans-serif;">
            <span class="w-8 h-[1px] bg-charcoal-muted inline-block"></span>
            <span class="text-[11px] font-medium tracking-[0.12em] uppercase text-charcoal-muted">Career</span>
          </div>
          <h1 class="text-[clamp(2.5rem,6vw,5.5rem)] font-800 tracking-[-0.03em] leading-[0.95]" style="font-family: Archivo, sans-serif;">
            Experience<span class="text-terracotta">.</span>
          </h1>
          <p class="text-[15px] text-charcoal-muted max-w-[460px] mt-6 leading-[1.8]" style="font-family: Inter, sans-serif; font-weight: 300;">
            My journey so far — learning, building, and growing as a developer.
            Every project is a stepping stone toward mastery.
          </p>
        </div>
      </ScrollReveal>

      <!-- Experience List -->
      <div class="flex flex-col">
        {experiences.map((exp, i) => (
          <ScrollReveal client:visible delay={i * 0.12}>
            <div class="py-10 md:py-14 border-t border-charcoal/[0.06]">
              <div class="grid md:grid-cols-12 gap-6">
                
                <div class="md:col-span-3">
                  <span class="text-[12px] font-medium text-charcoal-muted tracking-[0.04em] block mb-1" style="font-family: Inter, sans-serif;">{exp.period}</span>
                  <span class="text-[13px] text-terracotta font-medium" style="font-family: Inter, sans-serif;">{exp.company}</span>
                </div>
                
                <div class="md:col-span-9">
                  <div class="max-w-[600px]">
                    <h2 class="text-[clamp(1.4rem,2.5vw,2rem)] font-600 tracking-[-0.01em] mb-3" style="font-family: Archivo, sans-serif;">
                      {exp.title}
                    </h2>
                    <p class="text-[14px] leading-[1.85] text-charcoal-muted font-light mb-6" style="font-family: Inter, sans-serif;">
                      {exp.description}
                    </p>

                    <!-- Highlights -->
                    <div class="mb-5">
                      <h4 class="text-[11px] font-medium tracking-[0.1em] uppercase text-charcoal-muted mb-3" style="font-family: Inter, sans-serif;">Key Highlights</h4>
                      <ul class="space-y-2">
                        {exp.highlights.map(h => (
                          <li class="text-[13px] leading-[1.7] text-charcoal-light font-light flex items-start gap-2.5" style="font-family: Inter, sans-serif;">
                            <span class="w-1 h-1 rounded-full bg-terracotta mt-2 flex-shrink-0"></span>
                            {h}
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="flex flex-wrap gap-1.5">
                      {exp.tags.map(tag => (
                        <span class="tag-pill">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </ScrollReveal>
        ))}
        <div class="border-t border-charcoal/[0.06]"></div>
      </div>

      <!-- Education section to fill space -->
      <ScrollReveal client:visible>
        <div class="mt-16 md:mt-24">
          <div class="grid md:grid-cols-12 gap-6">
            <div class="md:col-span-3">
              <span class="text-[11px] font-medium tracking-[0.12em] uppercase text-charcoal-muted block mb-3" style="font-family: Inter, sans-serif;">Education</span>
              <h2 class="text-[clamp(1.5rem,3vw,2.2rem)] font-700 tracking-[-0.02em]" style="font-family: Archivo, sans-serif;">
                Academic<br/> Background
              </h2>
            </div>
            <div class="md:col-span-9 pt-2">
              <div class="py-8 border-t border-charcoal/[0.06]">
                <h3 class="text-[1.1rem] font-600 tracking-[-0.01em] mb-1" style="font-family: Archivo, sans-serif;">
                  SRNY College of Arts and Science
                </h3>
                <span class="text-[13px] text-terracotta font-medium block mb-2" style="font-family: Inter, sans-serif;">B.Sc. in Information Technology · 2022 — 2025 · Kodikuruchi, Tenkasi (627809)</span>
                <p class="text-[14px] text-charcoal-muted leading-[1.8] font-light max-w-[500px]" style="font-family: Inter, sans-serif;">
                  Built core foundations in software systems, database management systems (DBMS), 
                  object-oriented programming, data structures, and computer network architectures.
                </p>
              </div>
              <div class="border-t border-charcoal/[0.06]"></div>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-charcoal/[0.06] py-8">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-[12px] text-charcoal-muted tracking-[0.04em]" style="font-family: Inter, sans-serif;">© 2026 Nithish</span>
      <div class="flex items-center gap-6">
        <a href="https://github.com/l-nithish" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">GitHub</a>
        <a href="https://linkedin.com" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">LinkedIn</a>
      </div>
    </div>
  </footer>
</Layout>
