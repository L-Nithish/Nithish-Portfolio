const skillCategories = [
  {
    title: "Core Languages",
    description: "The fundamental build tools of my applications.",
    skills: [
      { name: "HTML5", logo: logos.html, level: "Advanced", floatClass: "bob-1" },
      { name: "CSS3", logo: logos.css, level: "Advanced", floatClass: "bob-2" },
      { name: "JavaScript", logo: logos.js, level: "Advanced", floatClass: "bob-3" },
      { name: "Core Java", logo: logos.java, level: "Advanced", floatClass: "bob-4" },
      { name: "SQL", logo: logos.sql, level: "Intermediate", floatClass: "bob-2" },
      { name: "MySQL", logo: logos.mysql, level: "Intermediate", floatClass: "bob-1" }
    ]
  },
  {
    title: "Backend Skills",
    description: "Creating secure, decoupled server architectures.",
    skills: [
      { name: "Spring Boot", logo: logos.springboot, level: "Advanced", floatClass: "bob-3" },
      { name: "REST APIs", logo: logos.api, level: "Advanced", floatClass: "bob-4" },
      { name: "WebSockets", logo: logos.websocket, level: "Intermediate", floatClass: "bob-1" }
    ]
  },
  {
    title: "AI & Workflows",
    description: "Leveraging model integration and automated pipelines.",
    skills: [
      { name: "Prompt Engineering", logo: logos.ai, level: "Specialist", floatClass: "bob-2" },
      { name: "n8n Integration", logo: logos.n8n, level: "Trained", floatClass: "bob-3" },
      { name: "AI Web Builders", logo: logos.ai, level: "Claude, ChatGPT, Gemini, Antigravity", floatClass: "bob-1" }
    ]
  },
  {
    title: "Development Tools",
    description: "Systems and environments that optimize productivity.",
    skills: [
      { name: "VS Code", logo: logos.vscode, level: "Expert", floatClass: "bob-4" },
      { name: "IntelliJ IDEA", logo: logos.intellij, level: "Expert", floatClass: "bob-3" },
      { name: "GitHub", logo: logos.github, level: "Advanced", floatClass: "bob-2" }
    ]
  },
  {
    title: "Deployment & Cloud",
    description: "Delivering codebases to static CDNs and container environments.",
    skills: [
      { name: "Vercel", logo: logos.deployment, level: "Frontend hosting", floatClass: "bob-1" },
      { name: "Netlify", logo: logos.deployment, level: "Frontend hosting", floatClass: "bob-3" },
      { name: "Render", logo: logos.deployment, level: "Backend container hosting", floatClass: "bob-2" },
      { name: "GitHub Pages", logo: logos.deployment, level: "Static hosting", floatClass: "bob-4" }
    ]
  }
];
---

<Layout title="Skills — Nithish">
  <Navbar client:load />

  <section class="pt-[72px]">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-28">
      
      <!-- Header -->
      <ScrollReveal client:load>
        <div class="mb-16 md:mb-24">
          <div class="flex items-center gap-3 mb-6" style="font-family: Inter, sans-serif;">
            <span class="w-8 h-[1px] bg-charcoal-muted inline-block"></span>
            <span class="text-[11px] font-medium tracking-[0.12em] uppercase text-charcoal-muted">Competencies</span>
          </div>
          <h1 class="text-[clamp(2.5rem,6vw,5.5rem)] font-800 tracking-[-0.03em] leading-[0.95]" style="font-family: Archivo, sans-serif;">
            Skills & Tools<span class="text-terracotta">.</span>
          </h1>
          <p class="text-[15px] text-charcoal-muted max-w-[460px] mt-6 leading-[1.8]" style="font-family: Inter, sans-serif; font-weight: 300;">
            A detailed breakdown of my full stack expertise, visual tooling, 
            deployment workflows, and integrations with AI assistant tools.
          </p>
        </div>
      </ScrollReveal>

      <!-- Skill Categories Column Layout -->
      <div class="space-y-16 md:space-y-24">
        {skillCategories.map((category) => (
          <div class="grid lg:grid-cols-12 gap-8 md:gap-6 pt-10 border-t border-charcoal/[0.06]">
            
            <!-- Category Title (Left) -->
            <div class="lg:col-span-4">
              <ScrollReveal client:visible>
                <h2 class="text-[clamp(1.5rem,2.8vw,2rem)] font-700 tracking-[-0.02em] mb-2" style="font-family: Archivo, sans-serif;">
                  {category.title}
                </h2>
                <p class="text-[13px] text-charcoal-muted leading-[1.6] max-w-[280px]" style="font-family: Inter, sans-serif;">
                  {category.description}
                </p>
              </ScrollReveal>
            </div>

            <!-- Skill Boxes Grid (Right) -->
            <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-4">
              {category.skills.map((skill, index) => (
                <ScrollReveal client:visible delay={index * 0.05}>
                  <div class={`group flex items-center gap-3.5 p-4 bg-cream-dark border border-charcoal/8 hover:border-terracotta/20 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1.5 ${skill.floatClass} cursor-default`}>
                    
                    <!-- Icon container -->
                    <div class="w-10 h-10 rounded-xl bg-charcoal/4 flex items-center justify-center group-hover:bg-terracotta/5 transition-colors duration-300 flex-shrink-0" set:html={skill.logo} />
                    
                    <!-- Text details -->
                    <div>
                      <h4 class="text-[13px] font-semibold text-charcoal leading-tight" style="font-family: Archivo, sans-serif;">
                        {skill.name}
                      </h4>
                      <span class="text-[10px] text-charcoal-muted font-light leading-none" style="font-family: Inter, sans-serif;">
                        {skill.level}
                      </span>
                    </div>

                  </div>
                </ScrollReveal>
              ))}
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-charcoal/[0.06] py-8">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-[12px] text-charcoal-muted tracking-[0.04em]" style="font-family: Inter, sans-serif;">© 2026 Nithish</span>
      <div class="flex items-center gap-6">
        <a href="https://github.com/l-nithish" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">GitHub</a>
        <a href="https://linkedin.com" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">LinkedIn</a>
      </div>
    </div>
  </footer>
</Layout>
