  intellij: `<svg class="w-7 h-7 text-[#000000]" viewBox="0 0 24 24" fill="currentColor"><path d="M0 0h24v24H0V0zm14.3 4.8c-.5-.5-1.2-.8-2-.8-1.6 0-2.8 1.1-2.8 2.8 0 1.6 1.2 2.8 2.8 2.8.8 0 1.5-.3 2-.8l-1.2-1.2c-.2.2-.5.3-.8.3-.7 0-1.2-.5-1.2-1.2 0-.7.5-1.2 1.2-1.2.3 0 .6.1.8.3l1.2-1.2zm-6.2 8.4H5.9v5.9h2.2v-5.9zm8 .5c-.7 0-1.2.5-1.2 1.2 0 .7.5 1.2 1.2 1.2.3 0 .6-.1.8-.3v.8c0 .7-.5 1.2-1.2 1.2-.7 0-1.2-.5-1.2-1.2H13c0 1.6 1.2 2.8 2.8 2.8s2.8-1.2 2.8-2.8v-2.9h-2.2v.2c-.2-.2-.5-.3-.8-.3z"/></svg>`,
  ai: `<svg class="w-7 h-7 text-purple-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  n8n: `<svg class="w-7 h-7 text-[#FF6D5A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>`,
  deployment: `<svg class="w-7 h-7 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
