---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import ScrollReveal from '../../components/ScrollReveal.jsx';
import ProjectList from '../../components/ProjectList.jsx';
---

<Layout title="Projects — Nithish">
  <Navbar client:load />

  <section class="pt-[72px]">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-28">
      
      <!-- Header -->
      <ScrollReveal client:load>
        <div class="mb-16 md:mb-24">
          <div class="flex items-center gap-3 mb-6" style="font-family: Inter, sans-serif;">
            <span class="w-8 h-[1px] bg-charcoal-muted inline-block"></span>
            <span class="text-[11px] font-medium tracking-[0.12em] uppercase text-charcoal-muted">Portfolio</span>
          </div>
          <h1 class="text-[clamp(2.5rem,6vw,5.5rem)] font-800 tracking-[-0.03em] leading-[0.95]" style="font-family: Archivo, sans-serif;">
            Projects<span class="text-terracotta">.</span>
          </h1>
          <p class="text-[15px] text-charcoal-muted max-w-[480px] mt-6 leading-[1.8]" style="font-family: Inter, sans-serif; font-weight: 300;">
            A collection of digital products where robust backend engineering meets minimalist design. Each codebase represents a deep dive into modular architectures, high-concurrency systems, and polished user interactions.
          </p>
        </div>
      </ScrollReveal>

      <!-- Project stats bar -->
      <ScrollReveal client:load delay={0.15}>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16 md:mb-20 py-8 border-y border-charcoal/[0.06]">
          <div>
            <span class="text-[clamp(1.8rem,3vw,2.5rem)] font-700 text-charcoal block" style="font-family: Archivo, sans-serif;">04</span>
            <span class="text-[11px] font-medium tracking-[0.1em] uppercase text-charcoal-muted" style="font-family: Inter, sans-serif;">Total Projects</span>
          </div>
          <div>
            <span class="text-[clamp(1.8rem,3vw,2.5rem)] font-700 text-charcoal block" style="font-family: Archivo, sans-serif;">04</span>
            <span class="text-[11px] font-medium tracking-[0.1em] uppercase text-charcoal-muted" style="font-family: Inter, sans-serif;">Live Websites</span>
          </div>
          <div>
            <span class="text-[clamp(1.8rem,3vw,2.5rem)] font-700 text-charcoal block" style="font-family: Archivo, sans-serif;">08+</span>
            <span class="text-[11px] font-medium tracking-[0.1em] uppercase text-charcoal-muted" style="font-family: Inter, sans-serif;">Technologies</span>
          </div>
          <div>
            <span class="text-[clamp(1.8rem,3vw,2.5rem)] font-700 text-terracotta block" style="font-family: Archivo, sans-serif;">∞</span>
            <span class="text-[11px] font-medium tracking-[0.1em] uppercase text-charcoal-muted" style="font-family: Inter, sans-serif;">Lines of Code</span>
          </div>
        </div>
      </ScrollReveal>

      <!-- Project List -->
      <ProjectList client:visible showAll={true} />
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-charcoal/[0.06] py-8 mt-8">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-[12px] text-charcoal-muted tracking-[0.04em]" style="font-family: Inter, sans-serif;">
        © 2026 Nithish. All rights reserved.
      </span>
      <div class="flex items-center gap-6">
        <a href="https://github.com/l-nithish" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">GitHub</a>
        <a href="https://linkedin.com" target="_blank" class="text-[12px] text-charcoal-muted hover:text-charcoal tracking-[0.04em] uppercase transition-colors duration-300" style="font-family: Inter, sans-serif;">LinkedIn</a>
      </div>
    </div>
  </footer>
</Layout>
